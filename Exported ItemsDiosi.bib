
@article{diosi_gravity-related_2011,
	title = {The gravity-related decoherence master equation from hybrid dynamics},
	url = {http://arxiv.org/abs/1101.0672},
	abstract = {Canonical coupling between classical and quantum systems cannot result in reversible equations, rather it leads to irreversible master equations. Coupling of quantized non-relativistic matter to gravity is illustrated by a simplistic example. The heuristic derivation yields the theory of gravity-related decoherence proposed longtime ago by Penrose and the author.},
	urldate = {2011-01-05},
	journal = {1101.0672},
	author = {Diósi, Lajos},
	month = jan,
	year = {2011},
	keywords = {General Relativity and Quantum Cosmology, Quantum Physics},
