
@article{zhou_quantum-limited_2019,
	title = {Quantum-limited estimation of the axial separation of two incoherent point sources},
	volume = {6},
	issn = {2334-2536},
	url = {http://arxiv.org/abs/1810.01027},
	doi = {10.1364/OPTICA.6.000534},
	abstract = {Improving axial resolution is crucial for three-dimensional optical imaging systems. Here we present a scheme of axial superresolution for two incoherent point sources based on spatial mode demultiplexing. A radial mode sorter is used to losslessly decompose the optical fields into a radial mode basis set to extract the phase information associated with the axial positions of the point sources. We show theoretically and experimentally that, in the limit of a zero axial separation, our scheme allows for reaching the quantum Cram{\textbackslash}'er-Rao lower bound and thus can be considered as one of the optimal measurement methods. Unlike other superresolution schemes, this scheme does not require neither activation of fluorophores nor sophisticated stabilization control. Moreover, it is applicable to the localization of a single point source in the axial direction. Our demonstration can be useful to a variety of applications such as far-field fluorescence microscopy.},
	number = {5},
	urldate = {2023-03-29},
	journal = {Optica},
	author = {Zhou, Yiyu and Yang, Jing and Hassett, Jeremy D. and Rafsanjani, Seyed Mohammad Hashemi and Mirhosseini, Mohammad and Vamivakas, A. Nick and Jordan, Andrew N. and Shi, Zhimin and Boyd, Robert W.},
	month = may,
	year = {2019},
	note = {arXiv:1810.01027 [physics, physics:quant-ph]},
	keywords = {Quantum Physics, Physics - Optics},
	pages = {534},
	annote = {Comment: Comments are welcome},
	file = {arXiv.org Snapshot:C\:\\Users\\danyb\\Zotero\\storage\\F7KT5WYP\\1810.html:text/html;Zhou et al_2019_Quantum-limited estimation of the axial separation of two incoherent point.pdf:C\:\\Users\\danyb\\Zotero\\storage\\G7WZ76EU\\Zhou et al_2019_Quantum-limited estimation of the axial separation of two incoherent point.pdf:application/pdf},
