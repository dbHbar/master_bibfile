
@article{schmidt_spectroscopy_2005,
	title = {Spectroscopy {Using} {Quantum} {Logic}},
	volume = {309},
	url = {https://www.science.org/doi/full/10.1126/science.1114375},
	doi = {10.1126/science.1114375},
	abstract = {We present a general technique for precision spectroscopy of atoms that lack suitable transitions for efficient laser cooling, internal state preparation, and detection. In our implementation with trapped atomic ions, an auxiliary “logic” ion provides sympathetic laser cooling, state initialization, and detection for a simultaneously trapped “spectroscopy” ion. Detection is achieved by applying a mapping operation to each ion, which results in a coherent transfer of the spectroscopy ion's internal state onto the logic ion, where it is then measured with high efficiency. Experimental realization, by using 9Be+ as the logic ion and 27Al+ as the spectroscopy ion, indicates the feasibility of applying this technique to make accurate optical clocks based on single ions.},
	number = {5735},
	urldate = {2026-11-06},
	journal = {Science},
	publisher = {American Association for the Advancement of Science},
	author = {Schmidt, P. O. and Rosenband, T. and Langer, C. and Itano, W. M. and Bergquist, J. C. and Wineland, D. J.},
	month = jul,
	year = {2005},
	pages = {749--752},
	file = {Full Text PDF:C\:\\Users\\danyb\\Zotero\\storage\\XE6QJQV2\\Schmidt et al. - 2005 - Spectroscopy Using Quantum Logic.pdf:application/pdf},
}
